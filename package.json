{
  "name": "orangehrm",
  "version": "1.0.0",
  "description": "Playwright Automation Framework for OrangeHRM",
  "main": "index.js",
  "scripts": {
    "test_dev": "cross-env ENV_NAME=dev npx playwright test",
    "test_demo": "cross-env ENV_NAME=demo npx playwright test",
    "test_demo_cr_hd": "cross-env ENV_NAME=demo npx playwright test --project=chromium --headed",
    "test_demo_fr_hd": "cross-env ENV_NAME=demo npx playwright test --project=firefox --headed",
    "test_demo_cr_hl": "cross-env ENV_NAME=demo npx playwright test --project=chromium",
    "test_demo_fr_hl": "cross-env ENV_NAME=demo npx playwright test --project=firefox",
    "test_demo_ui" : "cross-env ENV_NAME=demo npx playwright test  --ui",
    "test_uat_cr_hd" : "cross-env ENV_NAME=demo npx playwright test --project=chromium --grep=@UAT",

    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "allure:generate": "allure generate ./allure-results -o ./allure-report --clean",
    "allure:open": "allure open ./allure-report",
    "allure:serve": "allure serve ./allure-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.1.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2"
  }
}
